---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NEXUS — Ephemeral Private Chat (Astro Edition)",
  description = "Zero-Knowledge, Zero-Trace Ephemeral Chat on Cloudflare Edge with Web Crypto API",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --bg-main: #090b10;
        --card-bg: rgba(18, 22, 33, 0.75);
        --border-color: rgba(99, 102, 241, 0.18);
        --accent: #6366f1;
        --cyan: #22d3ee;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-main);
        color: #f8fafc;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="bg-[#090b10] text-slate-100 min-h-screen antialiased selection:bg-indigo-500/30 selection:text-indigo-200">
    <slot />
  </body>
</html>
