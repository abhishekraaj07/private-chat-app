---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NEXUS — Ephemeral Private Chat (Glassmorphic Edition)",
  description = "Zero-Knowledge, Zero-Trace Ephemeral Chat on Cloudflare Edge with Glassmorphism UI",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --bg-main: #07090E;
        --glass-bg: rgba(14, 18, 27, 0.65);
        --glass-border: rgba(255, 255, 255, 0.09);
        --glass-border-hover: rgba(56, 189, 248, 0.35);
        --accent-cyan: #38BDF8;
        --accent-violet: #8B5CF6;
      }
      
      body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-main);
        color: #EDEDED;
        font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
      }

      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }

      /* Ambient Glassmorphism Glow Orbs */
      .ambient-glow {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }
      .ambient-orb-1 {
        position: absolute;
        top: -10%;
        left: 15%;
        width: 550px;
        height: 550px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, rgba(14, 165, 233, 0.02) 60%, transparent 80%);
        filter: blur(80px);
        animation: floatOrb 18s ease-in-out infinite alternate;
      }
      .ambient-orb-2 {
        position: absolute;
        bottom: -15%;
        right: 10%;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.13) 0%, rgba(99, 102, 241, 0.02) 65%, transparent 80%);
        filter: blur(90px);
        animation: floatOrb 22s ease-in-out infinite alternate-reverse;
      }
      .ambient-orb-3 {
        position: absolute;
        top: 45%;
        right: 40%;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.07) 0%, transparent 70%);
        filter: blur(80px);
      }

      @keyframes floatOrb {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(30px, 40px) scale(1.08); }
        100% { transform: translate(-25px, -30px) scale(0.95); }
      }

      /* Glassmorphism Classes */
      .glass-panel {
        background: rgba(14, 18, 27, 0.68) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.1) !important;
      }

      .glass-card {
        background: rgba(18, 23, 34, 0.58) !important;
        backdrop-filter: blur(24px) saturate(190%) !important;
        -webkit-backdrop-filter: blur(24px) saturate(190%) !important;
        border: 1px solid rgba(255, 255, 255, 0.09) !important;
        box-shadow: 0 16px 40px 0 rgba(0, 0, 0, 0.5), inset 0 1px 1px 0 rgba(255, 255, 255, 0.12) !important;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
      }
      .glass-card:hover {
        border-color: rgba(56, 189, 248, 0.35) !important;
        box-shadow: 0 20px 48px 0 rgba(0, 0, 0, 0.6), 0 0 24px 0 rgba(56, 189, 248, 0.12), inset 0 1px 1px 0 rgba(255, 255, 255, 0.18) !important;
      }

      .glass-input {
        background: rgba(11, 15, 23, 0.65) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.3) !important;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
      }
      .glass-input:focus {
        border-color: rgba(56, 189, 248, 0.6) !important;
        box-shadow: 0 0 24px rgba(56, 189, 248, 0.25), inset 0 2px 4px 0 rgba(0, 0, 0, 0.3) !important;
        outline: none !important;
      }

      .glass-btn-primary {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.9) 0%, rgba(14, 165, 233, 0.95) 100%) !important;
        backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        box-shadow: 0 6px 20px rgba(56, 189, 248, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
        transition: all 0.2s ease !important;
      }
      .glass-btn-primary:hover {
        transform: translateY(-1px) !important;
        box-shadow: 0 8px 28px rgba(56, 189, 248, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.5) !important;
      }

      .glass-btn-secondary {
        background: rgba(22, 28, 42, 0.55) !important;
        backdrop-filter: blur(14px) !important;
        -webkit-backdrop-filter: blur(14px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
        transition: all 0.2s ease !important;
      }
      .glass-btn-secondary:hover {
        background: rgba(30, 38, 58, 0.75) !important;
        border-color: rgba(56, 189, 248, 0.35) !important;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35), 0 0 16px rgba(56, 189, 248, 0.15) !important;
      }

      /* Chat Bubble Glassmorphism */
      .glass-bubble-own {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.18) 0%, rgba(14, 165, 233, 0.1) 100%) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(56, 189, 248, 0.35) !important;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15) !important;
      }

      .glass-bubble-peer {
        background: rgba(18, 23, 34, 0.65) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
      }

      /* Custom Glass Scrollbars */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.12);
        border-radius: 999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: rgba(56, 189, 248, 0.4);
      }
    </style>
  </head>
  <body class="bg-[#07090E] text-[#EDEDED] min-h-screen antialiased selection:bg-[#38BDF8]/30 selection:text-[#38BDF8] relative">
    <!-- Ambient Luminous Mesh Underlay -->
    <div class="ambient-glow">
      <div class="ambient-orb-1"></div>
      <div class="ambient-orb-2"></div>
      <div class="ambient-orb-3"></div>
    </div>
    
    <!-- Page Content Slot -->
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
